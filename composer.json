{
    "name": "caicesardev/uncode-builder-abilities",
    "description": "WordPress Abilities that expose the WPBakery / Uncode page builder to AI agents through MCP.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "caicesardev",
            "homepage": "https://caicesardev.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "roots/wordpress-no-content": "^6.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-core-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress"
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit"
    }
}
