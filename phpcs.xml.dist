<?xml version="1.0"?>
<ruleset name="Uncode Builder Abilities">
	<description>WordPress coding standards and PHP 7.4+ compatibility.</description>

	<file>uncode-builder-abilities.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.9"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress-Extra">
		<!-- Exception messages go to JSON responses for AI agents, never to HTML. -->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="uncode-builder-abilities"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="uncode_builder_abilities"/>
				<element value="Uncode_Builder_Abilities"/>
			</property>
		</properties>
	</rule>
</ruleset>
